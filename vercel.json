{
  "rewrites": [
    {
      "source": "/api/finnhub/:path*",
      "destination": "https://finnhub.io/api/v1/:path*"
    },
    {
      "source": "/api/cnn",
      "destination": "https://production.dataviz.cnn.io/index/fearandgreed/graphdata"
    },
    {
      "source": "/api/fng",
      "destination": "https://api.alternative.me/fng/?limit=1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
